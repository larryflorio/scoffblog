---
import { u } from '../lib';
import '../styles/global.css';
import { chev, search, person } from '../components';
interface Props { title?: string; description?: string; current?: string }
const { title, description = 'Independent news and analysis on the Supreme Court of Fantasy Football.', current } = Astro.props;
const fullTitle = title ? `${title} | SCOFFblog` : 'SCOFFblog: Independent news and analysis on the Supreme Court of Fantasy Football';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <div class="utility">
      <div class="wrap">
        <nav>
          <a href={u("/cases")}>Cases<Fragment set:html={chev} /></a>
          <a href={u("/statistics")}>Statistics<Fragment set:html={chev} /></a>
          <a href={u("/calendar")}>Calendar</a>
          <a href={u("/justices")}>Justices</a>
        </nav>
        <div class="tools">
          <a href={u("/cases")} aria-label="Search"><Fragment set:html={search} /></a>
          <a href={u("/about")} class="login"><Fragment set:html={person} /> Login</a>
        </div>
      </div>
    </div>
    <header class="masthead">
      <div class="wrap">
        <nav class="left">
          <a href={u("/news")}>News<Fragment set:html={chev} /></a>
          <a href={u("/news")}>Commentary<Fragment set:html={chev} /></a>
          <a href={u("/about")}>About<Fragment set:html={chev} /></a>
        </nav>
        <a class="wordmark" href={u("/")} aria-label="SCOFFblog"><b>SCOFF</b>blog</a>
        <nav class="right">
          <a href={u("/about")}>Newsletters<Fragment set:html={chev} /></a>
          <a href={u("/about")}>Podcasts<Fragment set:html={chev} /></a>
          <a class="subscribe" href={u("/about")}>Subscribe</a>
        </nav>
      </div>
    </header>
    <div class="secondary">
      <div class="wrap">
        <a href={u("/cases")}>Merits Cases</a>
        <a href={u("/news")}>Court News</a>
        <a href={u("/news")}>Explainers</a>
        <a href={u("/emergency-docket")}>Emergency appeals and applications</a>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <section class="newsletter">
      <div class="wrap">
        <div>
          <h3>Stay informed on every decision.</h3>
          <p>Receive essential Court news every morning, or whenever the Commissioner does something.</p>
        </div>
        <div>
          <form onsubmit="event.preventDefault(); this.querySelector('button').textContent='Referred to the Clerk';">
            <input type="email" placeholder="Your email address" aria-label="Email address" />
            <button type="submit">Subscribe Free</button>
          </form>
          <small>This site is protected by nothing. Submissions are referred to the Office of the Clerk [trash bin].</small>
        </div>
      </div>
    </section>
    <footer>
      <div class="wrap">
        <div>
          <div class="wordmark"><b>SCOFF</b>blog</div>
          <p class="blurb">The premier source for Supreme Court of Fantasy Football news, analysis, and data since Tuesday. Independent and non-partisan, except as to the Commissioner.</p>
        </div>
        <div><h5>Coverage</h5><ul><li><a href={u("/news")}>Latest News</a></li><li><a href={u("/news")}>Recurring Columns</a></li><li><a href={u("/news")}>Outside Opinions</a></li><li><a href={u("/emergency-docket")}>Interim Docket Blog</a></li></ul></div>
        <div><h5>Cases</h5><ul><li><a href={u("/cases")}>Oral Argument Docket</a></li><li><a href={u("/emergency-docket")}>Interim Docket</a></li><li><a href={u("/cases")}>Petitions</a></li><li><a href={u("/cases")}>Capital Cases</a></li><li><a href={u("/calendar")}>Calendar</a></li><li><a href={u("/statistics")}>Statistics</a></li></ul></div>
        <div><h5>Podcasts</h5><ul><li><a href={u("/about")}>Advisory Opinions</a></li><li><a href={u("/about")}>Divided Argument</a></li><li><a href={u("/about")}>Waiver Wire Watch</a></li></ul></div>
        <div><h5>Newsletters</h5><ul><li><a href={u("/about")}>SCOFFtoday</a></li><li><a href={u("/about")}>SCOFF Opinions</a></li></ul></div>
        <div><h5>About</h5><ul><li><a href={u("/about")}>Manifesto</a></li><li><a href={u("/justices")}>Staff</a></li><li><a href={u("/about")}>Contact Us</a></li><li><a href={u("/about")}>Submissions</a></li><li><a href={u("/about")}>FAQs</a></li><li><a href={u("/about")}>Merch</a></li></ul></div>
      </div>
      <div class="bottom">
        <div class="copy"><span>SC</span> &copy; 2026 SCOFFblog. All rights reserved, none enforced.</div>
        <div class="legal"><a href={u("/news")}>Archive</a><a href={u("/about")}>Privacy Policy</a><a href={u("/about")}>Editorial Policy</a><a href={u("/about")}>Terms of Use</a></div>
      </div>
      <div class="disclaimer">SCOFFblog is a work of satire about a fantasy football league. It is not affiliated with, endorsed by, or in any way connected to SCOTUSblog, the Supreme Court of the United States, or any actual court. No opinion published here is legal advice, a legal opinion, or binding on anyone, including the Commissioner, who has said as much.</div>
    </footer>
  </body>
</html>
