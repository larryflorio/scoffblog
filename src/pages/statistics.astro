---
import Base from '../layouts/Base.astro';
---
<Base title="Statistics" current="/statistics">
  <div class="wrap" style="max-width:820px;padding-top:32px;padding-bottom:60px">
    <div class="section-head"><h2>Stat Pack</h2></div>
    <div class="stats" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
      <div class="stat"><b>1</b><span>Cases granted</span></div>
      <div class="stat"><b>0</b><span>Commissioner reversals, ever</span></div>
      <div class="stat"><b>2</b><span>Filings referred to Clerk</span></div>
      <div class="stat"><b>100%</b><span>Filings unread below</span></div>
      <div class="stat"><b>2</b><span>Members in the Rule 23 class</span></div>
      <div class="stat"><b>2 hrs</b><span>Wakefulness at issue</span></div>
    </div>
  </div>
</Base>
