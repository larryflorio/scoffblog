---
import { u } from '../lib';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmtShort, byDate } from '../lib';
const posts = (await getCollection('posts')).sort(byDate);
---
<Base title="News" current="/news">
  <div class="wrap plain-list">
    <h1>Latest</h1>
    {posts.map(p => <div class="item"><span class="kicker">{p.data.kicker}</span><h3 class="headline"><a href={u(`/news/${p.id}`)}>{p.data.title}</a></h3>{p.data.dek && <p style="color:var(--ink-2);margin:8px 0 0;font-size:15px">{p.data.dek}</p>}<div class="byline"><i>By</i> <span class="name">{p.data.author}</span><span class="sep">/</span><span class="date">{fmtShort(p.data.date)}</span></div></div>)}
  </div>
</Base>
