---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmtShort, byDate } from '../lib';
const posts = (await getCollection('posts')).filter(p => p.data.kicker === 'EMERGENCY DOCKET').sort(byDate);
---
<Base title="Emergency Docket" current="/emergency-docket">
  <div class="hero-band"><h1>Interim Docket</h1><p>Emergency applications and interim orders.</p></div>
  <div class="wrap plain-list">
    <p class="lede">Applications for emergency relief, motions to compel, and anything filed after 11 p.m. The Court acts on these without argument, without briefing, and frequently without reading them, a practice it inherited from the court below.</p>
    {posts.length === 0 && <p>No applications pending.</p>}
    {posts.map(p => <div class="item"><span class="kicker">{p.data.kicker}</span><h3 class="headline"><a href={`/news/${p.id}`}>{p.data.title}</a></h3>{p.data.dek && <p style="color:var(--ink-2);margin:8px 0 0;font-size:15px">{p.data.dek}</p>}<div class="byline"><i>By</i> <span class="name">{p.data.author}</span><span class="sep">/</span><span class="date">{fmtShort(p.data.date)}</span></div></div>)}
  </div>
</Base>
