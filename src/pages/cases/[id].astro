---
import { u } from '../../lib';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtShort, byDate } from '../../lib';
import { arrow, chev, ext } from '../../components';
export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map(c => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const { Content } = await render(c);
const posts = (await getCollection('posts')).filter(p => p.data.case === c.id).sort(byDate);
const chip: Record<string, string> = { 'Granted': 'Cert. Granted', 'Petition pending': 'Petition Pending', 'Argued': 'Argued', 'Decided': 'Decided', 'Emergency application': 'Emergency Application' };
const cls = (e: string) => /(notice|motion|brief)[^.]*\bfiled\b/i.test(e) ? 'brief' : /commissioner declines|order of god emperor/i.test(e) ? 'gov' : 'order';
---
<Base title={c.data.title} description={c.data.issues[0]} current="/cases">
  <div class="wrap two case">
    <section>
      <div class="case-head">
        <span class="status-chip">{chip[c.data.status]}</span>
        <h1>{c.data.title}</h1>
      </div>
      <div class="meta">
        <div><label>Docket No.</label><a href="#">{c.data.docket}</a></div>
        <div><label>Op. Below</label><a href="#">{c.data.lowerDocket ?? 'Commissioner'}</a></div>
        <div><label>Argument</label>{c.data.argued ? fmtShort(c.data.argued) : 'Sep 6, 2026'}</div>
        <div><label>Term</label><a href={u("/cases")}>{c.data.term}</a></div>
        {c.data.decided && <div><label>Decided</label>{fmtShort(c.data.decided)}</div>}
      </div>
      <a class="btn" href={c.data.external[0]?.href ?? '#'} target="_blank" rel="noopener">Original filing <Fragment set:html={arrow} /></a>
      <h2>Issue</h2>
      <div class="issue">{c.data.issues.map((i, n) => <span>({n + 1}) {i.replace(/^Whether/, 'whether')} </span>)}</div>
      {c.data.holding && <><h2>Holding</h2><div class="issue">{c.data.holding}</div></>}
      <div class="tl-head"><h2 style="border:0;padding:0">Proceedings &amp; orders timeline</h2><span class="sel">Oldest first <Fragment set:html={chev} /></span></div>
      <div class="tl-key">Color key: <span style="--c:#fffedb"></span>Brief or filing <span style="--c:#dedede"></span>Commissioner <span style="--c:#fff"></span>Order</div>
      <ul class="tl">
        {c.data.timeline.map(t => <li class={cls(t.entry)}><span class="d">{t.date}</span><span class="e" set:html={t.entry} />{/filed|published/i.test(t.entry) && <a class="lk" href={c.data.external[0]?.href ?? '#'} target="_blank" rel="noopener" aria-label="Open"><Fragment set:html={ext} /></a>}</li>)}
      </ul>
      <div class="prose" style="margin-top:40px"><Content /></div>
      {c.data.exhibits.length > 0 && <div class="exhibits">
        <h2>Filings</h2>
        {c.data.exhibits.map(e => <figure class="exhibit"><a href={u(e.pdf ?? e.src)} target="_blank" rel="noopener"><img src={u(e.src)} alt={e.label} loading="lazy" /></a><figcaption>{e.label}{e.pdf && <> <a href={u(e.pdf)} target="_blank" rel="noopener" style="color:var(--navy);text-decoration:underline">Download</a></>}</figcaption></figure>)}
      </div>}
    </section>
    <aside class="side">
      <div class="crumbs"><a href={u("/cases")}>Cases</a><span>/</span><a href={u("/cases")}>{c.data.term}</a></div>
      <div><h4>Share</h4><div class="share"><a href="#" onclick="navigator.clipboard.writeText(location.href);this.textContent='Copied';return false;">Copy</a><a href={`https://x.com/intent/post?text=${encodeURIComponent(c.data.title)}&url=${encodeURIComponent(`https://scoffblog.com/cases/${c.id}`)}`} target="_blank" rel="noopener">Twitter</a><a href={`mailto:?subject=${encodeURIComponent(c.data.title)}`}>Email</a></div></div>
      {posts.length > 0 && <div class="rel"><h4>Related Coverage</h4>{posts.map(p => <div style="margin-bottom:18px"><h3 class="headline"><a href={u(`/news/${p.id}`)}>{p.data.title}</a></h3><div class="byline" style="font-variant:normal"><span class="date" style="font-variant:normal;letter-spacing:0;color:var(--ink-3)">{fmtShort(p.data.date)} &middot; {p.data.author}</span></div></div>)}</div>}
      {c.data.external.length > 0 && <div><h4>Elsewhere</h4><div class="rows">{c.data.external.map(x => <a href={x.href} target="_blank" rel="noopener">{x.label}</a>)}</div></div>}
    </aside>
  </div>
</Base>
