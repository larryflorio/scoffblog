---
import Base from '../layouts/Base.astro';
const events = [
  ['Wed, Sep 2', 'Orders', 'Certiorari before judgment granted in No. 26-1. Expedited schedule ordered.'],
  ['Fri, Sep 4', 'Briefing', 'Briefs on the merits due. Amicus briefs from league members who "just want to say something" due same day.'],
  ['Sun, Sep 6', 'Oral Argument', 'No. 26-1, Appellant v. God Emperor Commissioner. Argument conducted in the group chat. Time allotted: until someone leaves.'],
  ['Mon, Sep 7', 'Opinion', 'Opinion announcement in No. 26-1.'],
  ['Tue, Sep 8', 'Draft', 'League Draft. Time as ordered by this Court, or as the Commissioner pleases, whichever the parties comply with.'],
  ['Thu, Sep 10', 'Conference', 'First regular conference of the Term. Waiver claims, trade challenges, and lineup-lock petitions considered.'],
];
---
<Base title="Calendar" current="/calendar">
  <div class="wrap" style="max-width:820px;padding-top:32px;padding-bottom:60px">
    <div class="section-head"><h2>Calendar</h2></div>
    <ul class="events" style="font-size:16px">
      {events.map(([d, t, e]) => <li style="grid-template-columns:110px 1fr"><span class="d">{d}</span><span><span class="t">{t}</span>{e}</span></li>)}
    </ul>
  </div>
</Base>
